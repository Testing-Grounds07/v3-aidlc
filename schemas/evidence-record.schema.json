{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-record.schema.json",
  "title": "V3-AIDLC Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "kind", "subjectId", "subjectRevision",
    "producerId", "producerRole", "producerIndependenceGroup",
    "collectedAt", "locator", "sha256", "assertions"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^EVID-[A-Z0-9-]+$"},
    "kind": {"enum": ["artifact", "test_result", "build_result", "review_disposition", "scan_result", "observation", "metric", "decision", "provenance_manifest"]},
    "subjectId": {"type": "string", "minLength": 1},
    "subjectRevision": {"type": "string", "minLength": 1},
    "producerId": {"type": "string", "minLength": 1},
    "producerRole": {"type": "string", "minLength": 1},
    "producerIndependenceGroup": {"type": "string", "minLength": 1},
    "collectedAt": {"type": "string", "format": "date-time"},
    "locator": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "supersedes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}
