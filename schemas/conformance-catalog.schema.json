{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-aidlc.dev/schemas/conformance-catalog.schema.json",
  "title": "Conformance Scenario Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "conformance-scenario.schema.json"}
    }
  }
}
