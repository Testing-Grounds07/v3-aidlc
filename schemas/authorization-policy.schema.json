{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "authorization-policy.schema.json",
  "title": "V3-AIDLC Adaptive Authorization Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "scope", "defaultDecision", "rules"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^POL-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {"enum": ["organization", "project", "route", "workstream", "mode", "target"]},
    "defaultDecision": {"$ref": "#/$defs/decision"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "decision", "whenAll", "explanation"],
        "properties": {
          "id": {"type": "string", "pattern": "^RULE-[A-Z0-9-]+$"},
          "priority": {"type": "integer"},
          "decision": {"$ref": "#/$defs/decision"},
          "whenAll": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/predicate"}
          },
          "budgets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["fact", "maximum"],
              "properties": {
                "fact": {"type": "string", "minLength": 1},
                "maximum": {"type": "number"}
              }
            }
          },
          "onBudgetExceeded": {"const": "user_decision_required"},
          "explanation": {"type": "string", "minLength": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"decision": {"const": "auto_proceed_within_budget"}}},
            "then": {
              "required": ["budgets", "onBudgetExceeded"],
              "properties": {"budgets": {"minItems": 1}}
            },
            "else": {"not": {"required": ["budgets"]}}
          }
        ]
      }
    }
  },
  "$defs": {
    "decision": {
      "enum": [
        "auto_proceed",
        "auto_proceed_and_record",
        "auto_proceed_within_budget",
        "user_decision_required",
        "blocked"
      ]
    },
    "predicate": {
      "type": "object",
      "required": ["fact"],
      "properties": {
        "fact": {"type": "string", "minLength": 1},
        "equals": {},
        "in": {"type": "array", "minItems": 1}
      },
      "oneOf": [
        {"required": ["equals"], "not": {"required": ["in"]}},
        {"required": ["in"], "not": {"required": ["equals"]}}
      ],
      "additionalProperties": false
    }
  }
}
