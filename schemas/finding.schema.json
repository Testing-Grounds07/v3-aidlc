{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "finding.schema.json",
  "title": "V3-AIDLC Finding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "subjectId", "subjectRevision", "sourceEventId", "category", "severity", "status", "summary", "details", "evidenceIds", "ownerRole", "discoveredAt"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^FIND-"},
    "projectId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "minLength": 1},
    "subjectRevision": {"type": "string", "minLength": 1},
    "sourceEventId": {"type": "string", "minLength": 1},
    "category": {"enum": ["defect", "risk", "evidence_gap", "security", "compliance", "ambiguity", "integration", "operations"]},
    "severity": {"enum": ["info", "low", "medium", "high", "critical"]},
    "status": {"enum": ["open", "acknowledged", "repairing", "resolved", "accepted_risk", "superseded"]},
    "summary": {"type": "string", "minLength": 1},
    "details": {"type": "string", "minLength": 1},
    "evidenceIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "ownerRole": {"type": "string", "minLength": 1},
    "discoveredAt": {"type": "string", "format": "date-time"},
    "resolution": {"type": "string", "minLength": 1},
    "resolutionEventId": {"type": "string", "minLength": 1},
    "resolvedAt": {"type": "string", "format": "date-time"},
    "resolutionEvidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "decisionId": {"type": "string", "minLength": 1},
    "supersededByFindingId": {"type": "string", "minLength": 1}
  }
}
