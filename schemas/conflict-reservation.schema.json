{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-aidlc.dev/schemas/conflict-reservation.schema.json",
  "title": "Conflict and Quota Reservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["reservationId", "projectId", "workPackageId", "subjectRevision", "claims", "quotaCosts"],
  "properties": {
    "reservationId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "workPackageId": {"type": "string", "minLength": 1},
    "subjectRevision": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["domain", "access"],
        "properties": {
          "domain": {"type": "string", "minLength": 1},
          "access": {"enum": ["read", "write", "exclusive"]}
        }
      }
    },
    "quotaCosts": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 0}
    }
  }
}
