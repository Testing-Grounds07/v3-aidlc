{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate-contract.schema.json",
  "title": "V3-AIDLC Gate Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "title", "gateType", "acceptedExceptionAuthorities", "checkRules"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^GATE-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "gateType": {"enum": ["package", "bolt", "stage", "integration", "promotion", "release"]},
    "acceptedExceptionAuthorities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "checkRules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "requirement", "waivable", "hardControl"],
        "properties": {
          "checkId": {"type": "string", "pattern": "^CHECK-[A-Z0-9-]+$"},
          "requirement": {"enum": ["required", "conditional", "advisory"]},
          "whenAll": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["fact"],
              "properties": {"fact": {"type": "string"}, "equals": {}, "in": {"type": "array", "minItems": 1}},
              "oneOf": [
                {"required": ["equals"], "not": {"required": ["in"]}},
                {"required": ["in"], "not": {"required": ["equals"]}}
              ],
              "additionalProperties": false
            }
          },
          "waivable": {"type": "boolean"},
          "hardControl": {"type": "boolean"}
        }
      }
    }
  }
}
