{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "disclosure-grant.schema.json",
  "title": "V3-AIDLC Disclosure Grant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "recipientRole", "runIds", "itemIds", "purpose", "grantedBy", "authority", "expiresAt"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^GRANT-[A-Z0-9-]+$"},
    "projectId": {"type": "string", "minLength": 1},
    "recipientRole": {"type": "string", "minLength": 1},
    "runIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "itemIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "purpose": {"type": "string", "minLength": 1},
    "grantedBy": {"type": "string", "minLength": 1},
    "authority": {"enum": ["organization_policy", "project_policy", "user_decision"]},
    "expiresAt": {"type": "string", "format": "date-time"}
  }
}
