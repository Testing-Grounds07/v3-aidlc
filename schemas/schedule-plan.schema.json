{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-aidlc.dev/schemas/schedule-plan.schema.json",
  "title": "Schedule Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "stateRevision", "entries", "selectedWorkPackageIds"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "generatedAt": {"type": "string", "format": "date-time"},
    "stateRevision": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["workPackageId", "decision", "reasons", "effectivePriority"],
        "properties": {
          "workPackageId": {"type": "string", "minLength": 1},
          "decision": {"enum": ["selected", "deferred"]},
          "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "effectivePriority": {"type": "integer", "minimum": 0}
        }
      }
    },
    "selectedWorkPackageIds": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
