{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-aidlc.dev/schemas/package-manifest.schema.json",
  "title": "V3 Package Manifest",
  "type": "object",
  "required": ["schemaVersion", "packageName", "packageVersion", "frameworkVersion", "pythonRequires", "supportedSchemaVersions", "supportedProfileKinds", "artifacts"],
  "properties": {
    "schemaVersion": {"type": "string", "minLength": 1},
    "packageName": {"type": "string", "minLength": 1},
    "packageVersion": {"type": "string", "minLength": 1},
    "frameworkVersion": {"type": "string", "minLength": 1},
    "pythonRequires": {"type": "string", "minLength": 1},
    "supportedSchemaVersions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "supportedProfileKinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["local", "team", "hosted", "production"]}},
    "artifacts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
