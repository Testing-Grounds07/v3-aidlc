{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v3-aidlc.dev/schemas/scheduler-policy.schema.json",
  "title": "Scheduler Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "version", "limits", "agingWindowSeconds", "maxAgingBoost"],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "policyId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "limits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "agingWindowSeconds": {"type": "integer", "minimum": 1},
    "maxAgingBoost": {"type": "integer", "minimum": 0, "maximum": 5}
  }
}
