{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mode-contract.schema.json",
  "title": "V3-AIDLC Mode Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "id", "version", "title", "objective",
    "supportedStages", "requiredInputs", "roles", "requiredOutputs",
    "evidence", "completionCriteria", "hardControls", "attemptBudget",
    "postureProfiles", "outcomes"
  ],
  "properties": {
    "schemaVersion": {"const": "0.1"},
    "id": {"type": "string", "pattern": "^MODE-[A-Z0-9-]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "supportedStages": {
      "type": "array",
      "items": {"enum": ["discovery", "definition", "design", "implementation", "validation", "release", "operation", "retirement"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "requiredInputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "responsibility"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1}
        }
      }
    },
    "requiredOutputs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "evidence": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "completionCriteria": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "hardControls": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "attemptBudget": {"type": "integer", "minimum": 1},
    "postureProfiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "object"}
    },
    "outcomes": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "allowedNextModes": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  }
}

