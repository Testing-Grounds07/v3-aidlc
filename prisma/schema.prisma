generator client {
  provider = "prisma-client-js"
  output   = "../packages/database/src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FoundationRecord {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum RequirementStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum PlanStatus {
  DRAFT
  APPROVED
  SUPERSEDED
}

enum WorkPackageStatus {
  PROPOSED
  PLANNED
  ELIGIBLE
  LEASED
  RUNNING
  EVIDENCE_PENDING
  VERIFYING
  REVIEWING
  REPAIR_REQUIRED
  REPLAN_REQUIRED
  DECISION_REQUIRED
  BLOCKED
  ACCEPTED
  CLOSED
  CANCELLED
  SUPERSEDED
}

model Project {
  id               String                   @id
  name             String
  description      String
  status           ProjectStatus            @default(ACTIVE)
  version          Int                      @default(1)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  requirements     Requirement[]
  plans            Plan[]
  workPackages     WorkPackage[]
  events           LifecycleEvent[]
  repositories     RepositoryRegistration[]
  investigations   Investigation[]
  agentRuns        AgentRun[]
  evidence         EvidenceRecord[]
  gateDecisions    GateDecision[]
  worktrees        WorktreeSession[]
  proposals        ChangeProposal[]
  pullRequests     GitHubPullRequest[]
  decisionRequests DecisionRequest[]
  humanDecisions   HumanDecision[]
  delegations      StandingDelegation[]
}

model Requirement {
  id                 String                @id
  projectId          String
  project            Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String
  status             RequirementStatus     @default(DRAFT)
  version            Int                   @default(1)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  acceptanceCriteria AcceptanceCriterion[]

  @@index([projectId])
}

model AcceptanceCriterion {
  id                 String      @id
  requirementId      String
  requirement        Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  statement          String
  verificationMethod String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([requirementId])
}

model Plan {
  id           String        @id
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title        String
  objective    String
  status       PlanStatus    @default(DRAFT)
  version      Int           @default(1)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workPackages WorkPackage[]

  @@index([projectId])
}

model WorkPackage {
  id                   String              @id
  projectId            String
  project              Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  planId               String
  plan                 Plan                @relation(fields: [planId], references: [id], onDelete: Cascade)
  title                String
  objective            String
  status               WorkPackageStatus   @default(PROPOSED)
  version              Int                 @default(1)
  intentIds            String[]
  routeInstanceId      String?
  workstreamId         String?
  unitId               String?
  boltId               String?
  stage                String
  modeId               String?
  posture              String
  riskProfileId        String?
  expectedOutcomeTypes String[]
  promotionTarget      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  agentRuns            AgentRun[]
  evidence             EvidenceRecord[]
  gateDecisions        GateDecision[]
  worktrees            WorktreeSession[]
  proposals            ChangeProposal[]
  pullRequests         GitHubPullRequest[]

  @@index([projectId])
  @@index([planId])
  @@index([status])
}

model LifecycleEvent {
  sequence         BigInt   @id @default(autoincrement())
  id               String   @unique
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type             String
  aggregateType    String
  aggregateId      String
  aggregateVersion Int
  payload          Json
  occurredAt       DateTime @default(now())

  @@unique([aggregateType, aggregateId, aggregateVersion])
  @@index([projectId, sequence])
  @@index([aggregateType, aggregateId])
}

model RepositoryRegistration {
  id             String          @id
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rootPath       String
  defaultBranch  String
  headRevision   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  investigations Investigation[]

  @@unique([projectId, rootPath])
  @@index([projectId])
}

model Investigation {
  id           String                 @id
  projectId    String
  project      Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId String
  repository   RepositoryRegistration @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  task         String
  status       String
  artifactPath String
  digest       String
  manifest     Json
  createdAt    DateTime               @default(now())

  @@index([projectId, createdAt])
  @@index([repositoryId, createdAt])
}

model AgentRun {
  id                String      @id
  projectId         String
  project           Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId     String
  workPackage       WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  adapterId         String
  profileId         String
  requestDigest     String
  status            String
  summary           String
  artifactIds       String[]
  evidenceIds       String[]
  findingIds        String[]
  satisfiedCriteria String[]
  usage             Json
  providerResultRef String
  startedAt         DateTime
  finishedAt        DateTime
  createdAt         DateTime    @default(now())

  @@index([projectId, createdAt])
  @@index([workPackageId, createdAt])
  @@index([adapterId, status])
}

model EvidenceRecord {
  id                        String      @id
  projectId                 String
  project                   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId             String
  workPackage               WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  kind                      String
  subjectRevision           String
  producerId                String
  producerRole              String
  producerIndependenceGroup String
  collectedAt               DateTime
  locator                   String
  sha256                    String
  assertions                String[]
  createdAt                 DateTime    @default(now())

  @@index([projectId, createdAt])
  @@index([workPackageId, subjectRevision])
  @@index([sha256])
}

model GateDecision {
  id            String      @id
  projectId     String
  project       Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId String
  workPackage   WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  revision      String
  attempt       Int
  outcome       String
  promotable    Boolean
  reasons       String[]
  evidenceIds   String[]
  createdAt     DateTime    @default(now())

  @@unique([workPackageId, revision, attempt])
  @@index([projectId, createdAt])
}

model WorktreeSession {
  id             String           @id
  projectId      String
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId  String
  workPackage    WorkPackage      @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  repositoryRoot String
  worktreePath   String
  branch         String
  baseRevision   String
  headRevision   String
  status         String           @default("active")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  proposals      ChangeProposal[]

  @@unique([projectId, branch])
  @@unique([projectId, worktreePath])
  @@index([workPackageId, status])
}

model ChangeProposal {
  id                      String          @id
  projectId               String
  project                 Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId           String
  workPackage             WorkPackage     @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  worktreeSessionId       String
  worktreeSession         WorktreeSession @relation(fields: [worktreeSessionId], references: [id], onDelete: Cascade)
  title                   String
  body                    String
  baseRevision            String
  headRevision            String
  branch                  String
  changedFiles            String[]
  verificationEvidenceIds String[]
  digest                  String
  status                  String          @default("prepared")
  externalUrl             String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@unique([worktreeSessionId, headRevision])
  @@index([projectId, status])
  @@index([workPackageId, createdAt])
}

model GitHubPullRequest {
  id               String      @id
  projectId        String
  project          Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workPackageId    String
  workPackage      WorkPackage @relation(fields: [workPackageId], references: [id], onDelete: Cascade)
  changeProposalId String      @unique
  repository       String
  number           Int
  url              String
  baseBranch       String
  headBranch       String
  headRevision     String
  state            String
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([repository, number])
  @@index([projectId, state])
  @@index([workPackageId, createdAt])
}

model DecisionRequest {
  id                  String         @id
  projectId           String
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actionId            String
  headline            String
  explanation         String
  impact              String
  actionNeeded        String
  question            String
  options             Json
  recommendedOptionId String?
  unaffectedWork      String
  status              String         @default("pending")
  requestedAt         DateTime
  createdAt           DateTime       @default(now())
  decision            HumanDecision?

  @@index([projectId, status, requestedAt])
}

model HumanDecision {
  id                String          @id
  projectId         String
  project           Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  decisionRequestId String          @unique
  decisionRequest   DecisionRequest @relation(fields: [decisionRequestId], references: [id], onDelete: Cascade)
  selectedOptionId  String
  userWords         String
  submittedAt       DateTime
  createdAt         DateTime        @default(now())

  @@index([projectId, submittedAt])
}

model StandingDelegation {
  id               String    @id
  projectId        String
  project          Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  grantedBy        String
  actionTypes      String[]
  targets          String[]
  requiredEvidence String[]
  policyVersion    String
  userWords        String
  grantedAt        DateTime
  expiresAt        DateTime?
  revokedAt        DateTime?
  revocationWords  String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([projectId, revokedAt, expiresAt])
}
