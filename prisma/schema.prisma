generator client {
  provider = "prisma-client-js"
  output   = "../packages/database/src/generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model FoundationRecord {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}
